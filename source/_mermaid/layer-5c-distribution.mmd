config:
  layout: elk
---
erDiagram
  Profile ||--|{ ProfileSection : "profile / sections"
  ProfileSection |o--|{ Distribution : "distribution"

  %% Profile }o--o{ Entity_Source_MAP : "morphs as 'provenanceable'"
  Distribution }|--o| AreaCode : "areaCode"
  AreaCode }o--o| AreaCode : "parent"
  AreaCode }|--o| Area : area
  Area }o--o| Area : "parent"
  Area }o--o| Area : "accepted"

  AreaCode }|--|| Gazetteer_EXT : "gazetteer"
  Gazetteer_EXT ||--o| Reference : reference

  Distribution |o--o| ThreatStatus : threatStatus
  ThreatStatus }|--|| ThreatStatusAuthority_EXT : "authority"
  ThreatStatus }|--o| Area : "jurisdiction"
  ThreatStatusAuthority_EXT ||--o| Reference : "reference / threatStatusAuthority"
  ThreatStatus }|--o| TaxonName : "taxonName"
  ThreatStatus }o--o| TaxonConcept : "taxonConcept"

  Distribution }o--o| Entity_Source_MAP : "morphs as 'provenanceable'"
  Entity_Source_MAP }|--o| Reference : "reference"

  Distribution {
    int id PK
    int profile_id FK
    string locality "nullable"
    enum occurrence_status "nullable"
    enum establishment_means "nullable"
    enum degree_of_establishment "nullable"
    string event_date "nullable"
    string occurrence_remarks "nullable"
  }

  AreaCode {
    int id PK
    string scheme
    int level "nullable"
    string code
    string path    
  }

  Area {
    int id PK
    string name
    enum area_type
    bool is_accepted
    string area_path
  }

  ThreatStatus {
    int id PK
    enum status_term
    date start_date "nullable"
    date end_date "nullable"
    jsonb metadata "nullable"
    text remarks "nullable" 
  }