erDiagram
  Profile }o--o{ Image : images
  ProfileSection }o--o{ Image : images
  Specimen }o--o{ Image : images
  GlossaryTerm }o--o{ Image : images

  Image |o--|{ ImageCaption : "image"
  Image |o--|{ ImageAccessPoint : "image"

  Image {
    int id PK
    string uri
    enum image_type
    string scientific_name "nullable"
    string creator
    string rights_holder "nullable"
    string license "nullable"
    jsonb metadata "nullable"
  }

  ImageCaption {
    int id PK
    text caption_body 
    text formatted_caption
  }

  ImageAccessPoint {
    int id PK
    enum variant
    string format
    int width
    int height
  }