---
config:
    layout: elk
---
erDiagram
    TaxonConcept }o--o| TaxonConcept : "parentTaxonConcept"
    TaxonConcept ||--o{ TaxonName : "taxonName"
    TaxonConcept |o--|{ VerNacularNameUsageMap : "taxonConcept"
    VerNacularNameUsageMap }|--o| TaxonName : "taxonName"
    TaxonConcept |o--|{ ScientificNameUsageMap : "taxonConcept"
    ScientificNameUsageMap }|--o| TaxonName : "taxonName"
    TaxonName }o--o| TaxonName : "originalName"
    TaxonName |o--|{ NameRelationMap : "subjectTaxonName"
    NameRelationMap }|--o| TaxonName : "objectTaxonName"
    TaxonConcept }o--|| TaxonTree : "taxonTree"
    TaxonConcept |o--|{ TaxonTreeNode : "taxonConcept"
    TaxonTreeNode }o--o| TaxonTreeNode : "parent"
    TaxonTreeNode }o--|| TaxonTree : "taxonTree" 
    TaxonName |o--|{ NomenclaturalType : "typifiedName"
    NomenclaturalType |o--o| TaxonName : "typeName"
    NomenclaturalType ||--o| Specimen : "typeSpecimen"
    TaxonConcept |o--|{ TaxonConceptMapping : subjectTaxonConcept
    TaxonConceptMapping }|--o| TaxonConcept : objectTaxonConcept

    TaxonName }o--o| Agent : combinationAuthorship
    TaxonName }o--o| Agent : basionymAuthorship
    TaxonName }o--o| Agent : combinationAscribedAuthorship
    TaxonName }o--o| Agent : basionymAscribedAuthorship

    TaxonConcept ||--o{ Reference : accordingTo
    TaxonConceptMapping }o--o| Reference : "mappingAccordingTo /source"
    TaxonName |o--o{ Reference : namePublishedIn
    NomenclaturalType |o--o{ Reference : typeAccordingTo
    NomenclaturalType |o--o{ Reference : source

    TaxonConceptMapping }o--o| Agent : creator
    NomenclaturalType }o--o| Agent : creator

    TaxonConcept {
        string id PK
        enum taxonRank
        text remarks
        jsonb dynamicProperties
    }

    TaxonName {
        string id PK
        enum type "ScientificName /<br>VernacularName /<br>HybridFormula /<br>InformalName /<br>TaxonConceptLabel"
        string nameString
        string scientificNameAuthorship
        enum taxonRank
        enum nomenclaturalCode
        enum nomenclaturalStatus
        string language
        string namePublishedInLiteral
        string namePublishedInYear
        string genericName
        string infragenericEpithet
        string specificEpithet
        string infraspecificEpithet
        string cultivarEpithet
        string combinationAuthorLiteral
        string basionymAuthorLiteral
        string combinationAscribedAuthorLiteral
        string basionymAscribedAuthorLiteral
        text typificationLiteral
        text remarks
        jsonb dynamicProperties
        string dataset
        string version
    }

    ScientificNameUsageMap {
        enum relation "acceptedName /<br>synonym"
        text remarks
        jsonb dynamicProperties
    }

    NameRelationMap {
        enum relation "basionym /<br>replacedName /<br>basedOn /<br>laterHomonymOf /<br>conservedAgainst"
        text remarks
        jsonb dynamicProperties
    }

    TaxonTreeNode {
        int id PK
        int[] materializedPath
        text remarks
        jsonb dynamicProperties
    }

    TaxonTree {
        int id PK
        string name
        text remarks
        jsonb dynamicProperties
        string dataset
        string version
    }

    TaxonConceptMapping {
        string id PK
        enum mappingRelation "isCongruentWith /<br>includes /<br>isIncludedIn /<br>partiallyOverlaps /<br>/isDisjointFrom /<br>intersects"
        text remarks
        jsonb dynamicProperties
    }

    NomenclaturalType {
        string id
        enum typeOfType
        text remarks
        jsonb dynamicProperties
    }

    VerNacularNameUsageMap {
        bool isPreferred
        text remarks
        jsonb dynamicProperties
    }