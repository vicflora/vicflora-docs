---
config:
    layout: elk
---
erDiagram
  TaxonConcept |o--|| Profile : "taxonConcept / profile"

  %% Sections
  Profile |o--|{ ProfileSection : "profile"
  ProfileSection }|--|| ProfileDefItem : "profileDefItem"

  %% Nomenclature
  ProfileSection |o--o{ ScientificNameUsage : "scientificNameUsages"
  ScientificNameUsage }|--o| ScientificName_EXT : "scientificName"

  %% Vernacular names
  ProfileSection |o--o{ VernacularNameUsage : "vernacularNameUsages"
  VernacularNameUsage }|--o| VernacularName_EXT : "vernacularName"


  %% Distribution
  ProfileSection |o--o{ Distribution : "distribution"

  %% Vouchers
  ProfileSection }o--o{ Specimen : "specimens (vouchers)"
  Specimen }o--o| Image : "images"

  %% Media
  Profile }o--o{ Image : "images"
  ProfileSection }o--o{ Image : "images"

  %% References
  ProfileSection |o--o{ Reference : "source"
  Profile ||--|| Treatment_EXT : "treatment / profile"
  Treatment_EXT ||--o{ Reference : "reference / treatment" 
  Profile ||--|{ TreatmentVersion_EXT : "profile / treatmentVersions"
  TreatmentVersion_EXT ||--o{ Reference : "reference / treatmentVersion"
  Profile |o--o{ Reference : "source"
  Profile }o--o{ Reference : "references"

  %% Namespace
  Profile ||--o{ TaxonTree : "taxonTree"
  ProfileSection ||--o{ TaxonTree : "taxonTree"
  ProfileDefItem ||--o{ TaxonTree : "taxonTree"

  %% Maps
  Profile |o..o{ Occurrence : "occurrences"
  Profile |o..|{ MapDistribution : "mapDistribution"
  Profile |o..|{ Phenology : "phenology"
  MapDistribution ||..|{ Occurrence : "derivedFrom"
  Phenology ||..|{ Occurrence : "derivedFrom"

  Profile {
    int taxon_concept_id PK
  }

  ProfileDefItem {
    int id PK
    enum profile_section_type
    bool is_required
    int sort_order
  }

  ProfileSection {
    int id PK
    text body_text
    int sort_order "nullable"
  }