  VernacularName_EXT }|..o| TaxonConcept : "preferredVernacularName"


  TaxonConceptLabel_EXT ||--o| TaxonConcept : "label"
  HybridFormula_EXT ||--o| TaxonConcept : "label"
  InformalName_EXT ||--o| TaxonConcept : "label"


  %% Vernacular name usage
  VernacularName_EXT |o--|{ VernacularNameUsage_MAP : "vernacularName"
  VernacularNameUsage_MAP }|--o| TaxonConcept : "taxonConcept"
