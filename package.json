{
    "private": true,
    "type": "module",
    "scripts": {
        "update-shared": "git submodule update --remote --merge",
        "dev": "npm run update-shared && npx vite",
        "build": "npm run update-shared && npx vite build && ./vendor/bin/jigsaw build production",
        "linkify-erd": "node linkify-svgs.cjs",
        "build-erd": "find source/_mermaid/ -name '*.mmd' | xargs -I {} sh -c 'npx @mermaid-js/mermaid-cli@latest -c erd-config.json -p puppeteer-config.json --cssFile mermaid-style.css -i \"$1\" -o \"source/assets/images/erd/$(basename \"$1\" .mmd).svg\"' _ {} && npm run linkify-erd",
        "docs:generate": "php artisan docs:generate",
        "docs:staging": "./vendor/bin/jigsaw build staging",
        "docs:watch": "./vendor/bin/jigsaw watch staging"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.15.0",
        "@tighten/jigsaw-vite-plugin": "^1.0.1",
        "tailwindcss": "^4.1.0",
        "vite": "^6.4.1"
    },
    "dependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.8",
        "highlight.js": "^11.11.1",
        "jsdom": "^29.1.1"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "puppeteer@24.43.1": true
    }
}
